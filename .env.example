PORT=8000
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-public-domain.example

# 统一账号服务的公开 HTTPS 地址。
ACCOUNT_ISSUER=https://account.your-public-domain.example

# 账号、会话和产品登记文件。生产环境必须挂载持久化磁盘。
ACCOUNT_USERS_FILE=data/users.json
ACCOUNT_STATE_FILE=data/account-state.json
ACCOUNT_CLIENTS_FILE=config/account-clients.json

# 支付订单持久化文件。生产环境应放在受限的持久化磁盘中。
PAYMENT_ORDERS_FILE=data/orders.json

# 多个产品部署在同一主域名下时填写父域名，例如 .your-public-domain.example。
ACCOUNT_COOKIE_DOMAIN=

# 额外允许接入账号接口的来源。config/account-clients.json 中登记的来源会自动加入。
ACCOUNT_ALLOWED_ORIGINS=https://pingnan-plants-site.vercel.app,https://zhongzhongforever.net

# 只有位于可信反向代理后方时才设为 1。
TRUST_PROXY=0

ALIPAY_APP_ID=your-app-id
ALIPAY_PRIVATE_KEY_PATH=certs/app-private-key.pem
ALIPAY_PUBLIC_KEY_PATH=certs/alipay-public-key.pem
ALIPAY_KEY_TYPE=PKCS8

# 生产环境默认使用支付宝正式网关；沙箱联调时按开放平台控制台填写沙箱网关。
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 可选：填写签约支付宝账号对应的 seller_id，回调时会额外核对。
ALIPAY_SELLER_ID=
